APP_ENV=development
APP_NAME=智慧冰箱服务
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://mealflow:change-me@127.0.0.1:5435/mealflow_demo
CORS_ORIGINS=http://localhost:5173

# V1 uses cloud APIs only. Keep real keys in OS environment variables or an ignored .env.
LLM_PROVIDER=deepseek
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6
RUNTIME_HOUSEHOLD_ACTIVE_LIMIT=2
RUNTIME_QUEUE_CAPACITY=100
RETRIEVAL_MODE=demo
RETRIEVAL_EMBEDDING_MODEL=fake
RETRIEVAL_EMBEDDING_DIMENSIONS=64
# Model already cached: keep model loading offline to avoid HuggingFace network stalls.
RETRIEVAL_EMBEDDING_LOCAL_FILES_ONLY=false
RETRIEVAL_TEMPLATE_VERSION=v1
RETRIEVAL_TOKENIZER_VERSION=v1
# 向量通道 cosine 相似度下限；低于该值的候选视为不相关（0 = 关闭）。
RETRIEVAL_MIN_SIMILARITY=0.41
# 关键字通道的下限相对系数：精确词命中按 RETRIEVAL_MIN_SIMILARITY * 该系数判定，
# 因为真实烹饪问题可能命中相关文档的余弦只有 0.34-0.40，而完全无关正文约 0.22。
KEYWORD_SIMILARITY_RATIO=0.5
# DuckDuckGo HTML 当前不稳定；默认关闭，配置稳定搜索服务后再开启。
KNOWLEDGE_WEB_SEARCH_ENABLED=false
# 点名菜本地未命中时抓取下厨房摘要，再由模型整理成教程；与上面的技巧检索开关独立。
RECIPE_WEB_FALLBACK_ENABLED=true

# Shared OpenAI-compatible gateway for the two optional models.
AITECHFLUX_API_KEY=
AITECHFLUX_BASE_URL=https://aitechflux.com/v1
AITECHFLUX_GPT_MODEL=gpt-6.1-sol
AITECHFLUX_GROK_MODEL=grok-4.7


BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_TEXT_MODEL=glm-4.5-air
BIGMODEL_VISION_MODEL=glm-4.6v

DEMO_MODE=true
