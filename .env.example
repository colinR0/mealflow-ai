APP_ENV=development
APP_NAME=MealFlow API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://mealflow:change-me@127.0.0.1:5435/mealflow_demo
CORS_ORIGINS=http://localhost:5173

# V1 uses cloud APIs only. Keep real keys in OS environment variables or an ignored .env.
LLM_PROVIDER=deepseek
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6
RUNTIME_HOUSEHOLD_ACTIVE_LIMIT=2
RUNTIME_QUEUE_CAPACITY=100
RETRIEVAL_MODE=demo
RETRIEVAL_EMBEDDING_MODEL=fake
RETRIEVAL_EMBEDDING_DIMENSIONS=64
RETRIEVAL_TEMPLATE_VERSION=v1
RETRIEVAL_TOKENIZER_VERSION=v1

# Shared OpenAI-compatible gateway for the two optional models.
AITECHFLUX_API_KEY=
AITECHFLUX_BASE_URL=https://aitechflux.com/v1
AITECHFLUX_GPT_MODEL=gpt-6.1-sol
AITECHFLUX_GROK_MODEL=grok-4.7


BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_TEXT_MODEL=glm-4.5-air
BIGMODEL_VISION_MODEL=glm-4.6v

DEMO_MODE=true
